direction: LR
entidade Fornecedor { *Id, Nome, Cnpj }
entidade NotaFiscal { *Id, Numero, Chave }
entidade Recebimento { *Id, Status, Justificativa }
entidade Produto { *Id, Codigo, Descricao }
entidade Caixa { *Id, Codigo, Status }
entidade Cliente { *Id, Nome, CpfCnpj }
entidade PedidoVenda { *Id, Numero, Status }
entidade Carregamento { *Id, DataPrevista, Status }
entidade Veiculo { *Id, Placa, LimiteCaixas, Situacao }
entidade Motorista { *Id, Nome, ValidadeCnh }
entidade Usuario { *Id, Login, Perfil }
entidade fraca MovimentacaoCaixa { ~DataHora, Tipo }

relacionamento Emite (Fornecedor (1,1), NotaFiscal (0,N))
relacionamento Confere (NotaFiscal (1,1), Recebimento (0,1))
relacionamento Gera (Recebimento (1,1), Caixa (0,N))
relacionamento Contem (Caixa (0,N), Produto (1,1))
relacionamento Faz (PedidoVenda (0,N), Cliente (1,1))
relacionamento Leva (Carregamento (0,N), PedidoVenda (1,N)) { Resultado, Motivo }
relacionamento Usa (Carregamento (0,N), Veiculo (1,1))
relacionamento Dirige (Carregamento (0,N), Motorista (1,1))
relacionamento Carrega (Carregamento (0,1), Caixa (0,N))
relacionamento identificador Registra (Caixa (1,1), MovimentacaoCaixa! (0,N))
relacionamento Bipa (MovimentacaoCaixa (0,N), Usuario (1,1))
