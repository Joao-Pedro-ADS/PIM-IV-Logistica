@model Motorista

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Cpf" class="form-label">CPF (só números)</label>
                <input asp-for="Cpf" class="form-control font-monospace" />
                <span asp-validation-for="Cpf"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NumeroCnh" class="form-label">Número da CNH</label>
                <input asp-for="NumeroCnh" class="form-control font-monospace" />
                <span asp-validation-for="NumeroCnh"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ValidadeCnh" class="form-label">Validade da CNH</label>
                <input asp-for="ValidadeCnh" class="form-control" />
                <span asp-validation-for="ValidadeCnh"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="UsuarioId" class="form-label">Login do aplicativo</label>
                <select asp-for="UsuarioId" asp-items="(SelectList)ViewBag.Usuarios" class="form-select">
                    <option value="">Nenhum</option>
                </select>
            </div>
        </div>
    </div>
</div>
