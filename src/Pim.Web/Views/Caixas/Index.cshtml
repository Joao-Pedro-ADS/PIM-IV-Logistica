@model Caixa?
@{
    ViewData["Title"] = "Rastrear caixa";
}

<h1 class="h3 mb-3">Rastrear caixa</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-lg-4">
        <label for="codigo" class="form-label">Código da caixa</label>
        <input id="codigo" name="codigo" value="@ViewBag.Codigo" placeholder="CX00000001" class="form-control font-monospace" required />
    </div>
    <div class="col-sm-3 col-lg-2">
        <button type="submit" class="btn btn-primary w-100">Buscar</button>
    </div>
</form>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-warning" role="alert">@ViewBag.Erro</div>
}

@if (Model != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0 me-2">Caixa <span class="font-monospace">@Model.Codigo</span></h2>
                <partial name="_Status" model="Model.Status" />
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-3">Produto</dt>
                <dd class="col-sm-9">@(Model.Produto?.Descricao)</dd>
                <dt class="col-sm-3">Entrada</dt>
                <dd class="col-sm-9">Entrou pela nota @(Model.Recebimento?.NotaFiscal?.Numero) de @(Model.Recebimento?.NotaFiscal?.Fornecedor?.Nome)</dd>
                <dt class="col-sm-3">Pedido</dt>
                <dd class="col-sm-9">@(Model.PedidoVenda != null ? $"{Model.PedidoVenda.Numero} - {Model.PedidoVenda.Cliente?.Nome}" : "nenhum")</dd>
                <dt class="col-sm-3">Status atual</dt>
                <dd class="col-sm-9 mb-0">@Model.Status</dd>
            </dl>
        </div>
    </div>

    <h2 class="h5">Histórico</h2>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Data e hora</th><th>Movimentação</th><th>Usuário</th><th>Carregamento</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimentacoes.OrderBy(m => m.DataHora))
                    {
                        <tr>
                            <td>@m.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@m.Tipo</td>
                            <td>@(m.Usuario?.Nome)</td>
                            <td>@(m.CarregamentoId?.ToString() ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
