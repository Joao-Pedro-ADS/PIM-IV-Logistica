@model PedidoVenda
@{
    ViewData["Title"] = $"Pedido {Model.Numero}";
    var carregamentos = (List<CarregamentoPedido>)ViewBag.Carregamentos;
    var podeCancelar = Model.Status == StatusPedido.Aberto || Model.Status == StatusPedido.EmCarregamento;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-2">Pedido @Model.Numero</h1>
    <partial name="_Status" model="Model.Status" />
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@(Model.Cliente?.Nome)</dd>
            <dt class="col-sm-3">Endereço de entrega</dt>
            <dd class="col-sm-9">@Model.Endereco</dd>
            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">@Model.DataEmissao.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9 mb-0">@Model.Status</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Itens</h2>
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Código</th><th>Produto</th><th class="text-end">Caixas</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td class="font-monospace">@(item.Produto?.Codigo)</td>
                        <td>@(item.Produto?.Descricao)</td>
                        <td class="text-end">@item.Quantidade</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold"><td colspan="2">Total: @Model.TotalCaixas caixas</td><td></td></tr>
            </tfoot>
        </table>
    </div>
</div>

<h2 class="h5">Carregamentos</h2>
@if (!carregamentos.Any())
{
    <p class="text-body-secondary">O pedido ainda não entrou em carregamento.</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Carregamento</th><th>Veículo</th><th>Data</th><th>Entrega</th><th>Motivo</th></tr>
                </thead>
                <tbody>
                    @foreach (var cp in carregamentos)
                    {
                        <tr>
                            <td>@cp.CarregamentoId</td>
                            <td>@(cp.Carregamento?.Veiculo?.Placa)</td>
                            <td>@(cp.Carregamento?.DataPrevista.ToString("dd/MM/yyyy"))</td>
                            <td><partial name="_Status" model="cp.Resultado" /></td>
                            <td>@cp.Motivo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    @if (User.IsInRole("Gerente") && podeCancelar)
    {
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Cancelar pedido</button>
        </form>
    }
</div>
