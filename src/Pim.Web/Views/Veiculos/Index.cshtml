@model List<Veiculo>
@{
    ViewData["Title"] = "Veículos";
    var podeEditar = User.IsInRole("Gerente") || User.IsInRole("Frota");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Veículos</h1>
    @if (podeEditar)
    {
        <a asp-action="Criar" class="btn btn-primary">Novo veículo</a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Placa</th>
                    <th>Modelo</th>
                    <th class="text-end">Limite de caixas</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="font-monospace fw-semibold">@v.Placa</td>
                        <td>@v.Modelo</td>
                        <td class="text-end">@v.LimiteCaixas</td>
                        <td><partial name="_Status" model="v.Situacao" /></td>
                        <td class="text-end text-nowrap">
                            @if (podeEditar)
                            {
                                <a asp-action="Editar" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Etiqueta" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">QR Code</a>
                                <form asp-action="AlternarManutencao" asp-route-id="@v.Id" method="post">
                                    <button type="submit" class="btn btn-sm @(v.Situacao == SituacaoVeiculo.EmManutencao ? "btn-outline-success" : "btn-outline-secondary")">
                                        @(v.Situacao == SituacaoVeiculo.EmManutencao ? "Tirar da manutenção" : "Colocar em manutenção")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
