@model Recebimento
@{
    ViewData["Title"] = "Recebimento";
    var linhas = (List<LinhaConferencia>)ViewBag.Linhas;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-2">Recebimento da nota @(Model.NotaFiscal?.Numero)</h1>
    <partial name="_Status" model="Model.Status" />
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fornecedor</dt>
            <dd class="col-sm-9">@(Model.NotaFiscal?.Fornecedor?.Nome)</dd>
            <dt class="col-sm-3">Conferente</dt>
            <dd class="col-sm-9">@(Model.Conferente?.Nome)</dd>
            <dt class="col-sm-3">Início</dt>
            <dd class="col-sm-9">@Model.DataInicio.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Fim</dt>
            <dd class="col-sm-9">@(Model.DataFim?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9 mb-0">@Model.Status</dd>
        </dl>
    </div>
</div>

<h2 class="h5">Conferência com a nota</h2>
<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Produto</th><th class="text-end">Na nota</th><th class="text-end">Bipadas</th><th class="text-end">Diferença</th></tr>
            </thead>
            <tbody>
                @foreach (var l in linhas)
                {
                    <tr class="@(l.Diferenca != 0 ? "table-warning" : "")">
                        <td>@l.Produto</td>
                        <td class="text-end">@l.NaNota</td>
                        <td class="text-end">@l.Bipadas</td>
                        <td class="text-end fw-semibold @(l.Diferenca != 0 ? "text-danger" : "text-success")">@l.Diferenca</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.AprovadoPor != null)
{
    <div class="alert alert-success" role="status">
        <div><strong>Aprovado por:</strong> @Model.AprovadoPor.Nome</div>
        <div><strong>Justificativa:</strong> @Model.Justificativa</div>
    </div>
}

@if (Model.Status == StatusRecebimento.AguardandoAprovacao)
{
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning-subtle fw-semibold">Aprovar entrada com diferença</div>
        <div class="card-body">
            <form asp-action="Aprovar" asp-route-id="@Model.Id" method="post">
                <div class="mb-3">
                    <label for="justificativa" class="form-label">Justificativa</label>
                    <textarea id="justificativa" name="justificativa" rows="3" class="form-control" required></textarea>
                </div>
                <button type="submit" class="btn btn-warning">Aprovar</button>
            </form>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
