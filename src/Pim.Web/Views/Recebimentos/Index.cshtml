@model List<Recebimento>
@{
    ViewData["Title"] = "Recebimentos";
}

<h1 class="h3 mb-3">Recebimentos</h1>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Data</th>
                    <th>Nota</th>
                    <th>Fornecedor</th>
                    <th>Conferente</th>
                    <th>Caixas bipadas</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.DataInicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-semibold">@(r.NotaFiscal?.Numero)</td>
                        <td>@(r.NotaFiscal?.Fornecedor?.Nome)</td>
                        <td>@(r.Conferente?.Nome)</td>
                        <td>@r.Caixas.Count de @(r.NotaFiscal?.QuantidadeVolumes)</td>
                        <td><partial name="_Status" model="r.Status" /></td>
                        <td class="text-end"><a asp-action="Detalhes" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Detalhes</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
