@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center mt-md-5">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold text-primary mb-1">PIM Logística</h1>
            <p class="text-body-secondary mb-0">Pedidos, carregamentos e frota</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Entrar</h2>

                @if (ViewBag.Erro != null)
                {
                    <div class="alert alert-danger py-2" role="alert">@ViewBag.Erro</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label for="login" class="form-label">Login</label>
                        <input id="login" name="login" class="form-control" required autofocus autocomplete="username" />
                    </div>
                    <div class="mb-4">
                        <label for="senha" class="form-label">Senha</label>
                        <input id="senha" name="senha" type="password" class="form-control" required autocomplete="current-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>
